# Desarrollo: /api se reenvia a FastAPI mediante el proxy de Vite.
# No hace falta copiar este archivo si se utilizan los valores predeterminados.
VITE_API_URL=

# Cambiar si API_PORT en el .env de la raiz no es 8000.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# VITE_* es configuracion publica. No colocar contrasenas ni PIN.
