# Docker Compose lee este archivo desde la raiz, una vez copiado como .env.
# Completar los valores vacios; no copiar credenciales reales al repositorio.
#
# GENERAR LOS VALORES NUEVOS -- no reutilizar los de otra instalacion:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   python3 -c "import secrets; print(''.join(secrets.choice('0123456789') for _ in range(6)))"
#
# El primero da la contrasena de la base; el segundo, un PIN de 6 digitos.
# Los PIN de aca solo CREAN los perfiles que falten: no cambian los de cuentas
# que ya existan. Si la instalacion parte de un volcado anterior, los perfiles
# vienen con sus PIN viejos -- que conoce quien tuvo acceso a ese entorno -- y
# hay que rotarlos DESPUES de restaurar:
#
#   docker compose exec api python scripts/rotar_pin.py --todos --cerrar-turnos
#
# Ver DESPLIEGUE.md (pasos 5, 7 y 8) para el procedimiento completo.
POSTGRES_USER=ctot
POSTGRES_DB=fmu_lima
POSTGRES_PASSWORD=

# Puertos publicados en el equipo. API y PostgreSQL solo escuchan en loopback.
WEB_PORT=80
API_PORT=8000
DB_PORT=5433

# development habilita /docs; production deshabilita la documentacion de la API.
ENVIRONMENT=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# PIN de 6 a 8 digitos. Se usan al crear perfiles, no para rotar los existentes.
INITIAL_OPERATOR_PIN=
INITIAL_DGAC1_PIN=
INITIAL_DGAC2_PIN=

# Servidores separados por comas. Vacio utiliza los predeterminados del backend.
# En una red sin internet, indicar el servidor NTP institucional.
NTP_SERVERS=

# Normalmente vacio: el navegador usa /api mediante Nginx.
# Solo definir si el frontend debe acceder directamente a otra API.
# Es un valor publico incorporado al frontend al compilar; no colocar secretos.
VITE_API_URL=

# Carpeta destino de la copia externa del respaldo, fuera del disco del
# servidor (ops/backup-db.ps1 la lee). Sin esto los respaldos quedan todos en
# la misma maquina, y un disco que falla se lleva la base y sus copias.
RESPALDO_EXTERNO=
